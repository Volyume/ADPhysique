<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        E6A (approved 2026-07-02): WorkoutForegroundService is registered as a
        SHORT_SERVICE foreground service hosting the rest-window chronometer
        notification. shortService needs NO type-specific permission and NO
        Play Console FGS declaration (policy-exempt), unlike the previous
        commented-out "health" registration, which from Android 14 required a
        health runtime permission and a Play declaration with a demo video.
        FOREGROUND_SERVICE itself is declared at the app level (app.json).
        The service self-stops at rest end and implements onTimeout(), so the
        ~3-minute shortService deadline can never ANR the app. If the manifest
        type here ever disagrees with the type passed to startForeground() in
        WorkoutForegroundService.kt, the system throws at start.
    -->
    <application>
        <service
            android:name=".WorkoutForegroundService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
