{
  "name": "volyume",
  "version": "1.2.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/check-imports.cjs",
    "release:check": "npm ci --legacy-peer-deps --ignore-scripts && npx tsc --noEmit --strict && npm run lint && npm run check:imports && npm test -- --runInBand && npm run release:audit",
    "release:audit": "npm audit --omit=dev --audit-level=high || echo '[release:audit] Advisories reported above — NOT blocking the build. A newly published CVE must never break a build that compiles; these are reviewed and patched/overridden separately (build-host tooling advisories, e.g. expo CLI deps, are expected). Do not silence a shipped-runtime high here.'"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo|expo-.*|@expo|@expo/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|native-base|@shopify/.*|react-native-.*)/)"
    ],
    "moduleNameMapper": {
      "\\.(png|jpg|jpeg|gif|svg|webp|ttf|otf|mp3|mp4|wav)$": "<rootDir>/__mocks__/asset-stub.js",
      "^react-native-url-polyfill/auto$": "<rootDir>/__mocks__/url-polyfill-stub.js",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.js",
      "^expo-apple-authentication$": "<rootDir>/__mocks__/expo-apple-authentication.js",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.js",
      "^expo-document-picker$": "<rootDir>/__mocks__/expo-document-picker.js"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.43.4",
    "date-fns": "^3.6.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "live-activity": "file:./modules/live-activity",
    "promise": "^8.3.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health": "1.19.0",
    "react-native-health-connect": "~3.5.3",
    "react-native-iap": "^15.3.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "rest-timer-live": "file:./modules/rest-timer-live",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@babel/runtime": "^7.29.7",
    "ws": "^8.21.0",
    "undici": "^6.27.0",
    "@expo/plist": {
      "@xmldom/xmldom": "^0.8.13"
    },
    "react-native-health": {
      "@expo/fingerprint": "0.15.5"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@react-native-ml-kit/text-recognition",
          "react-native-health"
        ]
      }
    }
  },
  "private": true
}
