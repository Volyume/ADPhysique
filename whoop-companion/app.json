{
  "expo": {
    "name": "VOLYUME Pulse",
    "slug": "volyume-pulse",
    "owner": "volyume",
    "scheme": "volyumepulse",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "primaryColor": "#F59E0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.volyume.pulse",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "package": "app.volyume.pulse",
      "versionCode": 1,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "VOLYUME Pulse connects to your WHOOP strap over Bluetooth to read your heart rate, recovery, sleep and activity data directly from the band. Nothing leaves your device."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
