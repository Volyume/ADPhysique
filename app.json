{
  "expo": {
    "name": "Volyume",
    "slug": "volyume",
    "scheme": "volyume",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/volyume-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0D",
    "primaryColor": "#F59E0B",
    "splash": {
      "image": "./assets/volyume-splash-hero.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.volyume",
      "buildNumber": "2",
      "requireFullScreen": true,
      "associatedDomains": [
        "applinks:volyume.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take progress photos",
        "NSPhotoLibraryUsageDescription": "Used to select and save progress photos",
        "NSPhotoLibraryAddUsageDescription": "Used to save shared workout cards to your photo library",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/volyume-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "app.volyume",
      "versionCode": 2,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "volyume"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "volyume.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/volyume-icon.png",
          "color": "#F59E0B",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "icon": "./assets/volyume-icon.png",
      "color": "#F59E0B",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
