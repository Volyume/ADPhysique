{
  "expo": {
    "name": "Volyume",
    "slug": "volyume",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/volyume-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0D",
    "splash": {
      "image": "./assets/volyume-splash-hero.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.volyume",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take progress photos",
        "NSPhotoLibraryUsageDescription": "Used to select progress photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/volyume-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "app.volyume",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/volyume-icon.png",
          "color": "#00E5FF",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "icon": "./assets/volyume-icon.png",
      "color": "#00E5FF",
      "androidMode": "default"
    }
  }
}
