{
  "expo": {
    "name": "Volyume",
    "slug": "volyume",
    "owner": "volyume",
    "extra": {
      "eas": {
        "projectId": "2f60a6ed-8b37-4cd6-8057-60ee04e39ea8"
      }
    },
    "scheme": "volyume",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/volyume-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "primaryColor": "#F59E0B",
    "splash": {
      "image": "./assets/volyume-splash-hero.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.volyume",
      "buildNumber": "7",
      "requireFullScreen": true,
      "associatedDomains": ["applinks:volyume.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Volyume uses the camera to scan barcodes, read nutrition labels, and take progress photos.",
        "NSHealthShareUsageDescription": "Volyume reads your weight, daily steps, and completed cardio sessions including heart rate from Apple Health so your logs and trends stay in sync with your watch, scale, or other apps. Read only.",
        "NSHealthUpdateUsageDescription": "Volyume writes completed workouts to Apple Health so your weekly activity stays accurate across your other apps.",
        "NSMotionUsageDescription": "Volyume uses motion sensing for the shake-to-send-feedback gesture. Steps now come from Apple Health, not the phone's motion sensor.",
        "NSMicrophoneUsageDescription": "Volyume does not record audio. This entry is required by a bundled media library used for timer sounds and the permission is never requested.",
        "NSFaceIDUsageDescription": "Volyume does not use Face ID. This entry is required by the secure storage library that keeps your sign-in safe on this device.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "app.volyume",
      "versionCode": 14,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "volyume"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "volyume.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Volyume uses the camera to scan barcodes and read nutrition labels.",
          "enableCodeScanner": true,
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F59E0B",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": false,
            "manifestQueries": {
              "package": ["com.google.android.apps.healthdata"]
            }
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "volyume",
          "project": "volyume",
          "url": "https://sentry.io/"
        }
      ],
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Volyume reads your weight, daily steps, and completed cardio sessions including heart rate from Apple Health so your logs and trends stay in sync with your watch, scale, or other apps. Read only.",
          "healthUpdatePermission": "Volyume writes completed workouts to Apple Health so your weekly activity stays accurate across your other apps."
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissionDelegate",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextSession",
              "label": "Next session",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "Your next training session at a glance.",
              "previewImage": "./assets/notification-icon.png",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "WeeklyConsistency",
              "label": "Weekly consistency",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Sessions done this week and your streak.",
              "previewImage": "./assets/notification-icon.png",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "none"
            }
          ]
        }
      ]
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#F59E0B",
      "androidMode": "default"
    }
  }
}
