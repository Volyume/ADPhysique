# Public Supabase config (same project as mobile). Set these in the Cloudflare
# Pages project env, never commit real values. The service-role key is NOT used
# by the user web; it belongs to the admin app only, as an encrypted server-only
# var on that project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
